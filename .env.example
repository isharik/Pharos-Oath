# Recommended free hosted agent model: NVIDIA Nemotron 3.5 Super VL.
# All model keys are server-only; set them in Vercel project settings or .env.local.
AI_PROVIDER=auto
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional Gemini provider: set AI_PROVIDER=gemini, or it is selected when NVIDIA is unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RPC endpoints. OATH validates eth_chainId on every server request.
PHAROS_ATLANTIC_RPC_URL=https://atlantic.dplabs-internal.com
PHAROS_PACIFIC_RPC_URL=https://rpc.pharos.xyz
PHAROS_ATLANTIC_RPC_FALLBACK_URLS=
PHAROS_PACIFIC_RPC_FALLBACK_URLS=

# The hosted Pharos Chain MCP currently reports Pacific (chain ID 1672).
# Set an Atlantic-specific MCP endpoint to use MCP reads on Atlantic; OATH
# verifies its chain ID and falls back to the selected network's RPC in Auto.
PHAROS_MCP_URL=https://mcp.pharos.xyz/mcp
PHAROS_MCP_TOKEN=
PHAROS_ATLANTIC_MCP_URL=
PHAROS_ATLANTIC_MCP_TOKEN=
PHAROS_PACIFIC_MCP_URL=
PHAROS_PACIFIC_MCP_TOKEN=

# Optional docs MCP override; by default OATH queries the official llms.txt index.
PHAROS_DOCS_MCP_URL=
PHAROS_DOCS_MCP_TOKEN=
PHAROS_DOCS_INDEX_URL=https://docs.pharos.xyz/llms.txt

# Deploy OathRegistry.sol separately on each desired chain and set addresses.
OATH_REGISTRY_ATLANTIC_ADDRESS=
OATH_REGISTRY_PACIFIC_ADDRESS=

# Enable Atlantic native-PHRS x402 by setting X402_ENABLED=true and
# X402_ATLANTIC_FACILITATOR_URL to a facilitator that advertises that scheme.
# Its /premium 402 challenge supplies the amount and recipient dynamically.
X402_ENABLED=false
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
X402_ATLANTIC_FACILITATOR_URL=
X402_ATLANTIC_FACILITATOR_TOKEN=
X402_ATLANTIC_PAY_TO=
X402_ATLANTIC_ASSET=
X402_ATLANTIC_PRICE_BASE_UNITS=
X402_PACIFIC_FACILITATOR_URL=
X402_PACIFIC_FACILITATOR_TOKEN=
X402_PACIFIC_PAY_TO=
X402_PACIFIC_ASSET=
X402_PACIFIC_PRICE_BASE_UNITS=

PORT=3000
